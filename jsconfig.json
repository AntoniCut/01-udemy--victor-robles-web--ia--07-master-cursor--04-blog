{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["react", "react-dom", "vite/client"],
        "strict": false,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.js",
        "src/**/*.jsx",
        "types/**/*.d.js",
        "types/**/*.d.ts"
    ],
    "exclude": ["node_modules"]
}
